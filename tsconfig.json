{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    // D204（0918三轮修复批）：noImplicitReturns 启用（改动面 1 处显式收尾，ipc.ts
    // set-titlebar-overlay 混合返回形态）；exactOptionalPropertyTypes 实测全树 127 处
    // 错（{...(c ? {k:v} : {})} 精确写法与 {k: undefined} 赋值两类形态遍布 src+test，
    // 批内全修 = 大搅动面 + 高回归风险），按 G102 缓办先例留痕待独立批评估。
    "noImplicitReturns": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "test", "scripts", "*.config.ts"],
  "exclude": [
    "src/studio/web-next",
    "test/studio/webnext",
    // project-harness 校验器副本面：随上游整体替换（刷新见 bootstrap --force），
    // 按 Node 类型剥离直跑，导入带 .ts 扩展、风格随来源；纳入 tsc 只会产出「副本
    // 不合本仓编译口径」的假红。正确性由 check:harness 实跑与上游仓 spec 保证。
    // 本仓自己写死的门表（run-gates.ts 的 MODES）与 harness 清单仍在 scripts/ 下 ——
    // 清单是 JSON 不入 tsc；门表随 check:harness 每条实跑背书。
    "scripts/harness"
  ]
}
