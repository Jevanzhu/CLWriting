# CLWriting 环境变量样例（N-5，第十二轮——.gitignore 的 !.env.example 例外落地，
# 此前系空承诺）。注意：应用不内置 dotenv 自动加载——.env 仅作本地备忘，
# 生效须导出到 shell（或经 direnv/launchd 等注入 process.env）。
# 本地凭据不入库：.env 与 .env.* 均被忽略，仅本文件例外。

# RAG 检索提供方 API Key（src/rag/resolve.ts 读——本地免 UI 配置的注入通道）
# CLWRITING_RAG_API_KEY=sk-...

# studio 服务端口（默认 7878；src/studio/server）
# CLWRITING_PORT=7878

# 首字节超时（毫秒，LLM 流式响应）
# CLWRITING_FIRST_BYTE_TIMEOUT_MS=120000

# 桌面数据目录（默认 ~/Library/Application Support/clwriting）
# CLWRITING_DIR=
